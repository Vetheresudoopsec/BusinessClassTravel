# Business Class Travel — Apache rules for HostGator (also used by the local server).

# One address for search engines: always https://business-class-travel.com (the local server is left alone).
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$ [NC]
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://business-class-travel.com%{REQUEST_URI} [L,R=301]
  # /index.html is the home page, not a second copy of it.
  RewriteCond %{THE_REQUEST} \s/index\.html[\s?] [NC]
  RewriteRule ^index\.html$ / [L,R=301]
</IfModule>

ErrorDocument 404 /404.html

# Never serve hidden files such as .env or .git.
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

# Working folders that are not part of the site.
RedirectMatch 404 "^/(dev|tools|previous-design|cache)(/|$)"
RedirectMatch 404 "^/api/env\.php$"

# Compress text files, including the 560 KB airport list (about a quarter of the size once compressed).
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/javascript application/json image/svg+xml
</IfModule>

# Let browsers keep images and fonts for a month, and code and pages briefly so changes show up quickly.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/x-icon "access plus 30 days"
  ExpiresByType video/webm "access plus 30 days"
  ExpiresByType text/css "access plus 1 day"
  ExpiresByType application/javascript "access plus 1 day"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# Basic protections that also count toward search engines' page-experience checks.
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Strict-Transport-Security "max-age=31536000" "expr=%{HTTPS} == 'on'"
</IfModule>
