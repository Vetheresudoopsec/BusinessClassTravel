# Copy to .env and fill in. Never commit .env.
# On the server, put it in the site folder's html_private/ folder:
#   /home/discoets/BusinessClassTravel.com/html_private/.env
# That folder is closed to the web, and deployments never overwrite the .env in it.

# Duffel access token, used only by tools/sync-airports.php to download the airport list
# (https://app.duffel.com > Developers > Access tokens). A test token (duffel_test_...) works.
# Visitors' searches are never sent to Duffel.
DUFFEL_ACCESS_TOKEN=

# Optional: ipapi.co key, only needed above about 1,000 visitors a day.
IPAPI_KEY=

# Optional: ipinfo.io token, the second location service (free plan: 50,000 lookups a month).
IPINFO_TOKEN=

# Unsplash access key, used by api/photo.php for destination photos on the fare offers
# (https://unsplash.com/oauth/applications > your app > Keys > Access Key). Without it, cards use Picsum.
UNSPLASH_ACCESS_KEY=

# Development only: 1 saves quote emails to cache/mail/ instead of sending them to sales@.
# Leave empty on the live site.
MAIL_TEST=

# Mailchimp, for newsletter sign-ups from the prompt and the quote form's checkbox.
# API key: Mailchimp > Profile > Extras > API keys (ends in -us21 or similar).
# Audience ID: Audience > Settings > Audience name and defaults > Audience ID.
# Without these, each sign-up is emailed to sales@ to add by hand.
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=
# 1 = Mailchimp emails new subscribers a link to confirm first (double opt-in). Empty = added straight away.
MAILCHIMP_DOUBLE_OPTIN=
